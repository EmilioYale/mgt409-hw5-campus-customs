# Copy to .env (in this folder or any parent folder) and fill in. Never commit the real .env.

# Portkey gateway key. Every agent uses gpt-6-luna through Portkey.
PORTKEY_API_KEY=pk-your-portkey-key-here

# Optional. Default shown.
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional overrides (defaults: data/campus_customs_new.db and output/audit_trail.json).
# CAMPUS_CUSTOMS_DB=
# CAMPUS_CUSTOMS_AUDIT=
